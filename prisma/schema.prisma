generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Auth.js v5 (@auth/prisma-adapter) models.
// Source: https://github.com/nextauthjs/next-auth/blob/main/packages/adapter-prisma/prisma/schema.prisma
// Field names, types and constraints match the adapter's own schema exactly —
// a mismatch here surfaces in the OAuth callback as an opaque error, not a
// schema error.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  accounts Account[]
  sessions Session[]
  links    Link[]
  apiKeys  ApiKey[]
  domains  Domain[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

// Domain models.
model Link {
  id          String    @id @default(cuid())
  // Nullable: Step 39's anonymous demo creates links with no owner at all,
  // not links owned by some placeholder "system" user — a null userId can
  // never match an authenticated user's `where: { userId }` dashboard
  // queries, so anonymous links simply never appear in anyone's dashboard,
  // by construction rather than by an extra flag.
  userId      String?
  // Nullable: a link with no domain is served on SNIP_BASE_URL, the
  // long-standing default. Slugs stay globally unique regardless of domain
  // (see Domain's comment) — this column only changes which hostname a
  // link's short URL is displayed/QR-coded with, never how it's looked up.
  domainId    String?
  slug        String    @unique
  destination String
  title       String?
  isActive    Boolean   @default(true)
  expiresAt   DateTime?
  // Denormalized onto Link so the dashboard list can show click counts for
  // many links in one query, without a GROUP BY COUNT over ClickEvent.
  clickCount  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SetNull, not Cascade: deleting a domain detaches its links back to the
  // SNIP_BASE_URL default rather than destroying them — the same reasoning
  // as the nullable userId above.
  domain      Domain?      @relation(fields: [domainId], references: [id], onDelete: SetNull)
  clickEvents ClickEvent[]
  dailyStats  DailyStat[]

  @@index([userId])
  @@index([userId, createdAt])
}

// A custom hostname a user can attach their links to instead of the shared
// SNIP_BASE_URL. Ownership is proven with a DNS TXT record (see
// src/lib/domains.ts) before a domain can be selected for a link — verifying
// inside Snip is a separate step from actually routing traffic to this app,
// which still requires adding the domain in Vercel's own project settings
// (see the README's "Custom domains" section).
model Domain {
  id          String    @id @default(cuid())
  userId      String
  hostname    String    @unique
  verifyToken String
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  links Link[]

  @@index([userId])
}

model ClickEvent {
  id        String   @id @default(cuid())
  linkId    String
  ipHash    String
  country   String?
  city      String?
  region    String?
  device    String?
  os        String?
  browser   String?
  referrer  String?
  createdAt DateTime @default(now())

  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId, createdAt])
  @@index([createdAt])
}

model DailyStat {
  id             String   @id @default(cuid())
  linkId         String
  date           DateTime @db.Date
  clicks         Int
  uniqueVisitors Int
  countries      Json
  devices        Json
  referrers      Json

  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)

  // Idempotent upsert target for Step 33's daily aggregation — without this,
  // a retried cron run double-counts instead of overwriting.
  @@unique([linkId, date])
  @@index([linkId, date])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  // Only the SHA-256 hash of the key is ever stored — the plaintext is
  // shown to the user exactly once, at creation, and never persisted or
  // recoverable afterward. keyHash is what an incoming request is looked up
  // by; keyPrefix is only the first few characters, kept unhashed purely so
  // the settings page can show "which key is this" without ever storing
  // anything that could reconstruct the real secret.
  keyHash    String    @unique
  keyPrefix  String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
