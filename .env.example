# Neon Postgres (pooled — used at runtime; hostname contains "-pooler")
DATABASE_URL="postgresql://user:password@ep-example-123456-pooler.c-1.us-east-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require"

# Neon Postgres (direct — used for migrations; no "-pooler" in hostname)
DIRECT_URL="postgresql://user:password@ep-example-123456.c-1.us-east-1.aws.neon.tech/neondb?sslmode=require"
