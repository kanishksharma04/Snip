# Neon Postgres (pooled — used at runtime; hostname contains "-pooler")
DATABASE_URL="postgresql://user:password@ep-example-123456-pooler.c-1.us-east-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require"

# Neon Postgres (direct — used for migrations; no "-pooler" in hostname)
DIRECT_URL="postgresql://user:password@ep-example-123456.c-1.us-east-1.aws.neon.tech/neondb?sslmode=require"

# GitHub OAuth App (github.com/settings/developers)
AUTH_GITHUB_ID="placeholder-github-client-id"
AUTH_GITHUB_SECRET="placeholder-github-client-secret"

# Generate with: openssl rand -base64 33
AUTH_SECRET="placeholder-auth-secret"

# Snip's own deployed origin — used to reject a destination URL that points
# back at Snip itself (redirect loop). Must also be set on Vercel (Production).
SNIP_BASE_URL="https://your-app.vercel.app"

# Upstash Redis (upstash.com) — shared free-tier instance in production; all
# Snip keys are namespaced under "link:". See README's Infrastructure section.
UPSTASH_REDIS_REST_URL="https://example-example-00000.upstash.io"
UPSTASH_REDIS_REST_TOKEN="placeholder-upstash-token"

# Generate with: openssl rand -hex 32
IP_HASH_SALT="placeholder-ip-hash-salt"

# Authenticated cron endpoint (Step 34). Generate with: openssl rand -base64 33
# Must also be set on Vercel (Production) so its Cron Jobs can call
# /api/cron/aggregate with a matching Authorization header.
CRON_SECRET="placeholder-cron-secret"
